-- Fungsi FireTouch
local function fireTouch(part)
    if hrp and part then
        for i = 1,3 do  -- retry biar pasti ke-trigger
            firetouchinterest(hrp, part, 0)
            task.wait()
            firetouchinterest(hrp, part, 1)
        end
    end
end

-- Dapetin part checkpoint & summit
local function getCheckpointPart(i)
    local model = workspace:FindFirstChild("Checkpoints")
    if model and model:FindFirstChild("Checkpoint"..i) then
        return model["Checkpoint"..i]
    end
    return nil
end
local function getSummitPart()
