-- CFrame Fly
Tools:CreateToggle({
    Name = "CFrame Fly",
    CurrentValue = false,
    Flag = "ToggleCFrameFly",
    Callback = function(Value)
        local char = lp.Character or lp.CharacterAdded:Wait()
        local humanoid = char:WaitForChild("Humanoid")
        local Head = char:WaitForChild("Head")

        if Value then
            humanoid.PlatformStand = true
            Head.Anchored = true

            if CFloop then CFloop:Disconnect() end
            for _, conn in pairs(CFconnections) do conn:Disconnect() end
            CFconnections = {}

            if not IsOnMobile then
                local upConn = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then return end
                    if input.KeyCode == Enum.KeyCode.E then CF_UP = 1
                    elseif input.KeyCode == Enum.KeyCode.Q then CF_UP = -1 end
                end)
                local downConn = UserInputService.InputEnded:Connect(function(input, processed)
                    if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.Q then CF_UP = 0 end
                end)
                table.insert(CFconnections, upConn)
                table.insert(CFconnections, downConn)
            end

            CFloop = RunService.Heartbeat:Connect(function(deltaTime)
                local camera = workspace.CurrentCamera
                local moveVector = Vector3.new()

                if IsOnMobile then
                    local controlModule = require(lp.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
                    local dir = controlModule:GetMoveVector()
                    moveVector = (camera.CFrame.RightVector * dir.X + camera.CFrame.LookVector * -dir.Z)
                else
                    moveVector = (camera.CFrame.RightVector * CONTROL.R + camera.CFrame.RightVector * CONTROL.L + camera.CFrame.LookVector * CONTROL.F + camera.CFrame.LookVector * CONTROL.B)
                end

                moveVector = moveVector + Vector3.new(0, CF_UP, 0)

                local headCFrame = Head.CFrame
                local cameraCFrame = camera.CFrame
                local cameraOffset = headCFrame:ToObjectSpace(cameraCFrame).Position
                cameraCFrame = cameraCFrame * CFrame.new(-cameraOffset.X, -cameraOffset.Y, -cameraOffset.Z + 1)
                local cameraPosition = cameraCFrame.Position
                local headPosition = headCFrame.Position
                local objectSpaceVelocity = CFrame.new(cameraPosition, Vector3.new(headPosition.X, cameraPosition.Y, headPosition.Z)):VectorToObjectSpace(moveVector)

                Head.CFrame = CFrame.new(headPosition) * (cameraCFrame - cameraPosition) * CFrame.new(objectSpaceVelocity * CFspeed * deltaTime)
            end)
        else
            if CFloop then CFloop:Disconnect() CFloop = nil end
            for _, conn in pairs(CFconnections) do conn:Disconnect() end
            CFconnections = {}

            humanoid.PlatformStand = false
            Head.Anchored = false
            CF_UP = 0
        end
    end,
})

Tools:CreateSlider({
